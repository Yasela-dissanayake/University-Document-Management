# =============================================================================
# .env.example — copy this to .env and fill in your values.
# NEVER commit .env itself to version control.
# Generate FLASK_SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ─── Blockchain ───────────────────────────────────────────────────────────────
# Tenderly virtual testnet RPC URL
WEB3_PROVIDER=https://virtual.sepolia.eu.rpc.tenderly.co/YOUR-ENDPOINT-HERE

# Deployed UniversityRegistry contract address (after running hardhat ignition deploy)
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# Service wallet private key (the account that pays gas and is the contract owner)
# ⚠ ROTATE THIS KEY if it was ever committed to git history.
PRIVATE_KEY=YOUR_64_HEX_CHARACTER_PRIVATE_KEY_HERE

# ─── Flask ───────────────────────────────────────────────────────────────────
# Required secret key for session signing. Must be set — no fallback in production.
FLASK_SECRET_KEY=YOUR_FLASK_SECRET_KEY_HERE

# Set to 1 ONLY in local development. NEVER in production.
FLASK_DEBUG=0

# ─── IPFS ────────────────────────────────────────────────────────────────────
IPFS_API_URL=http://127.0.0.1:5001

# ─── ACL Encryption ──────────────────────────────────────────────────────────
# Optional: set this to use an env-sourced master secret instead of the file.
# If set, overrides python_backend/.acl_master_secret.
# Generate with: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# ACL_MASTER_SECRET=

# ─── Wallet Encryption ───────────────────────────────────────────────────────
WALLET_ENCRYPTION_KEY=YOUR_BASE64_FERNET_KEY_HERE

# ─── AI / Ollama ─────────────────────────────────────────────────────────────
LLAMA_API_BASE=http://localhost:11434
LLAMA_MODEL=llama3

# ─── System ──────────────────────────────────────────────────────────────────
UNIVERSITY_NAME=University_of_Peradeniya
ADMIN_ADDRESS=0xYOUR_ADMIN_ADDRESS_HERE
PORT=5000
